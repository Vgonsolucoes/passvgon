# URL de conexão com o banco de dados PostgreSQL
# Formato: postgresql://usuario:senha@host:5432/nome_banco?schema=public
# Exemplo: postgresql://user:pass@localhost:5432/pass_vgon?schema=public
DATABASE_URL=

# URL direta de conexão com o banco de dados (usada por Prisma Migrate e Prisma Studio em ambientes com poolers)
# Geralmente igual ao DATABASE_URL, mas sem o pooler quando aplicável
DIRECT_URL=

# URL base da aplicação usada pelo NextAuth para redirecionamentos e callbacks
# Exemplo: http://localhost:3000 em desenvolvimento
NEXTAUTH_URL=

# Chave secreta usada pelo NextAuth para assinar e criptografar tokens de sessão
# Deve ter pelo menos 32 caracteres aleatórios (ex: openssl rand -hex 16)
NEXTAUTH_SECRET=

# Chave de criptografia AES-256 usada para criptografar dados sensíveis na aplicação
# Deve ter pelo menos 32 caracteres aleatórios (ex: openssl rand -hex 16)
ENCRYPTION_KEY=

# Porta em que o servidor Next.js irá rodar
# Padrão: 3000
PORT=3000

# Ambiente em que a aplicação está rodando
# Valores aceitos: development | staging | production
APP_ENV=development

# Host do servidor SMTP para envio de e-mails
# Exemplo: smtp.gmail.com, smtp.sendgrid.net
SMTP_HOST=

# Porta do servidor SMTP
# Comum: 587 (STARTTLS), 465 (SSL/TLS), 25
SMTP_PORT=

# Usuário de autenticação no servidor SMTP
SMTP_USER=

# Senha/API Key de autenticação no servidor SMTP
SMTP_PASS=

# Endereço de e-mail padrão usado como remetente nos envios
# Exemplo: "Nome da Aplicação" <noreply@exemplo.com>
SMTP_FROM=

# Caminho absoluto do diretório onde os arquivos enviados (uploads) serão armazenados
# Exemplo: /app/uploads
UPLOAD_DIR=/app/uploads

# Caminho absoluto do diretório onde os backups do sistema serão armazenados
# Exemplo: /app/backups
BACKUP_DIR=/app/backups
